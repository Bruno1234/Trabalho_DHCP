  "resources": [
    {
      "mode": "data",
      "type": "template_file",
      "name": "cloudinit_dhcp_client",
      "provider": "provider[\"registry.terraform.io/hashicorp/template\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "filename": null,
            "id": "ffd2319cf5caa3abbc25f8995697613e13f50927f0c724ad58aacfda3a8198f6",
            "rendered": "#cloud-config\nhostname: dhcp-client\nusers:\n  - name: aluno\n    plain_text_passwd: \"1234\"\n    lock_passwd: false\n    shell: /bin/bash\n    sudo: [\"ALL=(ALL) NOPASSWD:ALL\"]\n\nwrite_files:\n  - path: /usr/local/bin/request-ip.sh\n    permissions: '0755'\n    content: |\n      #!/bin/bash\n      apt-get update\n      apt-get install -y isc-dhcp-client net-tools\n      iface=$(ip link | awk -F: '$0 ~ \"^[0-9]+: ens\" {print $2}' | tr -d ' ')\n      dhclient -v $iface\n\nruncmd:\n  - bash /usr/local/bin/request-ip.sh\n",
            "template": "#cloud-config\nhostname: dhcp-client\nusers:\n  - name: aluno\n    plain_text_passwd: \"1234\"\n    lock_passwd: false\n    shell: /bin/bash\n    sudo: [\"ALL=(ALL) NOPASSWD:ALL\"]\n\nwrite_files:\n  - path: /usr/local/bin/request-ip.sh\n    permissions: '0755'\n    content: |\n      #!/bin/bash\n      apt-get update\n      apt-get install -y isc-dhcp-client net-tools\n      iface=$(ip link | awk -F: '$0 ~ \"^[0-9]+: ens\" {print $2}' | tr -d ' ')\n      dhclient -v $iface\n\nruncmd:\n  - bash /usr/local/bin/request-ip.sh\n",
            "vars": null
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
        }
      ]
    },
    {
      "mode": "data",
      "type": "template_file",
      "name": "cloudinit_dhcp_server",
      "provider": "provider[\"registry.terraform.io/hashicorp/template\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "filename": null,
            "id": "18d7a3c88381eed1d86f9dee6d8fcbf6c3075a65be1cd99841ff5acc5fe93834",
            "rendered": "#cloud-config\nnetwork: {config: disabled}\n\nhostname: dhcp-server\nusers:\n  - name: aluno\n    plain_text_passwd: \"1234\"\n    lock_passwd: false\n    shell: /bin/bash\n    sudo: [\"ALL=(ALL) NOPASSWD:ALL\"]\n\nwrite_files:\n  - path: /etc/netplan/01-static.yaml\n    permissions: '0644'\n    content: |\n      network:\n        version: 2\n        renderer: networkd\n        ethernets:\n          ens3:\n            dhcp4: false\n            addresses: [10.0.0.2/8]\n            gateway4: 10.0.0.1\n            nameservers:\n              addresses: [8.8.8.8, 1.1.1.1]\n\n  - path: /etc/dhcp/dhcpd.conf\n    permissions: '0644'\n    content: |\n      subnet 10.0.0.0 netmask 255.0.0.0 {\n        range 10.0.0.10 10.0.0.15;\n        option routers 10.0.0.2;\n        option domain-name-servers 8.8.8.8;\n        default-lease-time 600;\n        max-lease-time 7200;\n      }\n\n  - path: /etc/default/isc-dhcp-server\n    permissions: '0644'\n    content: |\n      INTERFACESv4=\"ens3\"\n      INTERFACESv6=\"\"\n\n  - path: /usr/local/bin/installdhcp.sh\n    permissions: '0755'\n    content: |\n      #!/bin/bash\n      apt-get update\n      apt-get install -y isc-dhcp-server net-tools\n      systemctl enable isc-dhcp-server\n      systemctl restart isc-dhcp-server\n      ufw disable\n      echo \"net.ipv4.ip_forward = 1\" \u003e\u003e /etc/sysctl.conf\n      sysctl -p\n\n  - path: /usr/local/bin/installdhcpuser.sh\n    permissions: '0755'\n    content: |\n      #!/bin/bash\n\n      # Criar grupo dhcpd se não existir\n      if ! getent group dhcpd \u003e /dev/null; then\n        echo \"[+] Criando grupo dhcpd...\"\n        groupadd --system dhcpd\n      else\n        echo \"[=] Grupo dhcpd já existe.\"\n      fi\n\n      # Criar usuário dhcpd se não existir\n      if ! id dhcpd \u003e /dev/null 2\u003e\u00261; then\n        echo \"[+] Criando usuário dhcpd...\"\n        useradd --system --no-create-home --shell /usr/sbin/nologin --gid dhcpd dhcpd\n      else\n        echo \"[=] Usuário dhcpd já existe.\"\n      fi\n\n      # Reiniciar o serviço\n      echo \"[*] Reiniciando o serviço isc-dhcp-server...\"\n      systemctl restart isc-dhcp-server\n\n      # Verificar status\n      echo \"[*] Status atual do serviço:\"\n      systemctl status isc-dhcp-server --no-pager\n\nruncmd:\n  - netplan apply\n  - bash /usr/local/bin/installdhcp.sh\n  - bash /usr/local/bin/installdhcpuser.sh\n",
            "template": "#cloud-config\nnetwork: {config: disabled}\n\nhostname: dhcp-server\nusers:\n  - name: aluno\n    plain_text_passwd: \"1234\"\n    lock_passwd: false\n    shell: /bin/bash\n    sudo: [\"ALL=(ALL) NOPASSWD:ALL\"]\n\nwrite_files:\n  - path: /etc/netplan/01-static.yaml\n    permissions: '0644'\n    content: |\n      network:\n        version: 2\n        renderer: networkd\n        ethernets:\n          ens3:\n            dhcp4: false\n            addresses: [10.0.0.2/8]\n            gateway4: 10.0.0.1\n            nameservers:\n              addresses: [8.8.8.8, 1.1.1.1]\n\n  - path: /etc/dhcp/dhcpd.conf\n    permissions: '0644'\n    content: |\n      subnet 10.0.0.0 netmask 255.0.0.0 {\n        range 10.0.0.10 10.0.0.15;\n        option routers 10.0.0.2;\n        option domain-name-servers 8.8.8.8;\n        default-lease-time 600;\n        max-lease-time 7200;\n      }\n\n  - path: /etc/default/isc-dhcp-server\n    permissions: '0644'\n    content: |\n      INTERFACESv4=\"ens3\"\n      INTERFACESv6=\"\"\n\n  - path: /usr/local/bin/installdhcp.sh\n    permissions: '0755'\n    content: |\n      #!/bin/bash\n      apt-get update\n      apt-get install -y isc-dhcp-server net-tools\n      systemctl enable isc-dhcp-server\n      systemctl restart isc-dhcp-server\n      ufw disable\n      echo \"net.ipv4.ip_forward = 1\" \u003e\u003e /etc/sysctl.conf\n      sysctl -p\n\n  - path: /usr/local/bin/installdhcpuser.sh\n    permissions: '0755'\n    content: |\n      #!/bin/bash\n\n      # Criar grupo dhcpd se não existir\n      if ! getent group dhcpd \u003e /dev/null; then\n        echo \"[+] Criando grupo dhcpd...\"\n        groupadd --system dhcpd\n      else\n        echo \"[=] Grupo dhcpd já existe.\"\n      fi\n\n      # Criar usuário dhcpd se não existir\n      if ! id dhcpd \u003e /dev/null 2\u003e\u00261; then\n        echo \"[+] Criando usuário dhcpd...\"\n        useradd --system --no-create-home --shell /usr/sbin/nologin --gid dhcpd dhcpd\n      else\n        echo \"[=] Usuário dhcpd já existe.\"\n      fi\n\n      # Reiniciar o serviço\n      echo \"[*] Reiniciando o serviço isc-dhcp-server...\"\n      systemctl restart isc-dhcp-server\n\n      # Verificar status\n      echo \"[*] Status atual do serviço:\"\n      systemctl status isc-dhcp-server --no-pager\n\nruncmd:\n  - netplan apply\n  - bash /usr/local/bin/installdhcp.sh\n  - bash /usr/local/bin/installdhcpuser.sh\n",
            "vars": null
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
        }
      ]
